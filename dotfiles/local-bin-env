#!/bin/sh
# Add user binaries to PATH when they are not already present.
case ":${PATH}:" in
  *:"$HOME/.local/bin":*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Nix's Git uses this Fedora-managed CA bundle for HTTPS verification.
if [ -r /etc/pki/tls/certs/ca-bundle.crt ]; then
  export GIT_SSL_CAINFO=/etc/pki/tls/certs/ca-bundle.crt
fi
